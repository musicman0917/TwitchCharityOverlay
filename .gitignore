node_modules/
npm-debug.log
.DS_Store
.env
.env.local
.overlay-state.json

# These are seeded from their .example.json on first boot (see server.js),
# then mutated live by the admin portal -- never git-tracked past that
# point, so a future `git pull` can never conflict with or overwrite
# real data (uploaded sounds, uploaded images) you've set on the server.
# Edit *.example.json instead to change the shipped defaults.
public/donation-tiers.json
public/asset-images.json
zoo-events.json

# Same reasoning as above, for the actual uploaded files those JSON manifests
# point to -- keep the placeholder README in each folder tracked, but never
# the real uploaded sounds/images themselves.
public/Assets/Sounds/*
!public/Assets/Sounds/README.md
public/Assets/Images/*
!public/Assets/Images/README.md
