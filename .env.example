# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real secrets, since this repo is public.

# Password for the admin portal (public/admin.html). Required -- the admin
# portal rejects all logins until this is set to something.
ADMIN_PASSWORD=changeme

# Discord webhook URL for donation announcements (optional). Anyone with
# this URL can post to your Discord channel as the webhook, so treat it as
# a secret -- never commit a real value. Leave unset to disable Discord
# announcements entirely; everything else still works fine without it.
DISCORD_WEBHOOK_URL=

